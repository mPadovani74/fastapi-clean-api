# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-por-uma-chave-aleatoria-de-64-caracteres
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# development | production (em production /docs, /redoc e /openapi.json somem)
ENVIRONMENT=development
# Origens permitidas pelo CORS, separadas por vírgula
CORS_ORIGINS=http://localhost:5173
# No Docker o compose já define o caminho do banco
# DATABASE_URL=sqlite:///./app.db
